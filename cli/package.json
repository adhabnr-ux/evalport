{
  "name": "evalport-cli",
  "version": "1.0.0",
  "description": "EvalPort CLI",
  "bin": {
    "evalport": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --packages=external --external:evalport-sdk --outfile=dist/index.js",
    "prepack": "npm run build",
    "start": "npx tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "evalport-sdk": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.28.2"
  }
}
