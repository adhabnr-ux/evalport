{
  "description": "PROPOSED (issue #107 / Discussion #108, not yet normative): Lenient consumption (`mode: allow_unknown`): the same suite as unknown_field_suite_rejected.json is accepted with allow_unknown. The raw JSON Schema models strict mode only and rejects it.",
  "type": "suite",
  "mode": "allow_unknown",
  "expect": {
    "valid": true
  },
  "document": {
    "version": "1.0.0",
    "id": "suite_conformance",
    "threshold": 0.8,
    "config": {
      "parallel": 2,
      "concurrency": 2,
      "retry": {
        "max_attempts": 2,
        "jitter": true
      }
    },
    "graders": [
      {
        "id": "gr_exact",
        "type": "exact_match",
        "params": {
          "ignore_case": true
        }
      }
    ],
    "test_cases": [
      {
        "id": "tc_001",
        "input": "What is 2+2?",
        "expected_output": "4",
        "graders": [
          "gr_exact"
        ],
        "extra_tc_key": 1
      }
    ]
  }
}
